{
  "name": "zhiren/enterprise-api",
  "description": "Jiangxi Zhiren enterprise mini program API",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "qcloud/cos-sdk-v5": "^2.0",
    "topthink/framework": "~6.0.16",
    "topthink/think-orm": "^2.0"
  },
  "repositories": [{"type": "composer", "url": "https://repo.packagist.org"}],
  "autoload": {"psr-4": {"app\\": "app/"}},
  "config": {"preferred-install": "dist", "sort-packages": true},
  "scripts": {"post-autoload-dump": ["@php think service:discover", "@php think vendor:publish"]}
}
