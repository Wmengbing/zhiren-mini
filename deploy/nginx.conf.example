server {
    listen 443 ssl;
    server_name zhirencasting.cc;

    # 替换为实际证书路径和项目路径。
    ssl_certificate /www/server/panel/vhost/cert/zhirencasting.cc/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/zhirencasting.cc/privkey.pem;
    root /www/wwwroot/default/zhiren-mini/api/public;
    index index.php;
    client_max_body_size 6m;
    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    gzip on;
    gzip_min_length 1024;
    gzip_types application/json application/javascript text/css image/svg+xml;

    location ^~ /.well-known/acme-challenge/ { try_files $uri =404; }
    location ~ (^|/)\. { return 404; }
    location ~* ^/uploads/.*\.(php[0-9]*|phtml|phar|cgi|pl|sh)$ { return 404; }
    location /uploads/ { try_files $uri =404; expires 7d; access_log off; }

    location = /admin { return 302 /admin/; }
    location ^~ /admin/ {
        alias /www/wwwroot/default/zhiren-mini/admin/dist/;
        try_files $uri $uri/ /admin/index.html;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ ^/index\.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        # Verify the actual PHP-FPM socket in BaoTa.
        fastcgi_pass unix:/tmp/php-cgi-82.sock;
    }

    location ~ \.php$ { return 404; }
}
