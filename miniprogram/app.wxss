page{background:#f7f8fa;color:#1c2026;font-family:-apple-system,BlinkMacSystemFont,"Microsoft YaHei",sans-serif;font-size:28rpx}
view,text,button,input,textarea{box-sizing:border-box}
button::after{border:0}
button[disabled]{opacity:.5}
.container{padding:36rpx 32rpx 72rpx}
.eyebrow{font-size:18rpx;font-weight:600;letter-spacing:4rpx;line-height:1.6}
.section-title{display:flex;justify-content:space-between;align-items:flex-end;margin:54rpx 0 26rpx}
.section-kicker{font-size:18rpx;font-weight:600;letter-spacing:3rpx;color:#949ba6;margin-bottom:12rpx}
.section-title .title{font-size:37rpx;font-weight:700;letter-spacing:-1rpx;line-height:1.25}
.section-title .more{font-size:23rpx;color:#69717e;padding:8rpx 0 4rpx;white-space:nowrap}
.card{background:#fff;border:1rpx solid #e8eaee;border-radius:16rpx;overflow:hidden}
.card-padding{padding:32rpx}
.muted{color:#7c8490;line-height:1.6}
.small{font-size:23rpx}
.body-text{font-size:27rpx;line-height:1.9;color:#69717e}
.empty{padding:90rpx 30rpx;text-align:center;color:#9299a4;font-size:26rpx;line-height:1.8}
.primary-button,.ghost-button{display:flex;align-items:center;justify-content:center;border-radius:10rpx;font-size:28rpx;font-weight:600;height:96rpx;line-height:1.3;margin:0}
.primary-button{background:#ee642d;color:#fff;border:0;box-shadow:0 10rpx 22rpx rgba(238,100,45,.14)}
.primary-button:active{background:#d95521}
.ghost-button{border:1rpx solid #d4d8df;color:#20252d;background:#fff;box-shadow:none}
.product-grid{display:flex;flex-wrap:wrap;justify-content:space-between}
.product-card{width:calc(50% - 10rpx);background:#fff;border:1rpx solid #e5e8ed;border-radius:14rpx;overflow:hidden;margin-bottom:20rpx}
.product-visual{position:relative;background:#fff;overflow:hidden}
.product-image{width:100%;height:264rpx;background:#fff;display:block}
.product-index{position:absolute;left:16rpx;top:16rpx;z-index:1;font-size:16rpx;letter-spacing:2rpx;color:#777f8b;background:rgba(255,255,255,.8);padding:5rpx 9rpx;border-radius:3rpx}
.image-fallback{height:264rpx;background:linear-gradient(130deg,#e8ebef,#cbd0d7);display:flex;align-items:center;justify-content:center;color:#6c7480;font-weight:700;font-size:28rpx;letter-spacing:5rpx}
.product-info{padding:23rpx 20rpx 20rpx}
.product-name{font-size:27rpx;font-weight:600;overflow:hidden;white-space:normal;line-height:1.5;min-height:81rpx;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;word-break:break-word}
.product-subtitle{font-size:21rpx;color:#969da7;margin-top:10rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;line-height:1.5}
.product-card-foot{display:flex;justify-content:space-between;align-items:center;margin-top:24rpx;padding-top:17rpx;border-top:1rpx solid #f0f1f4;font-size:18rpx;color:#9299a4;letter-spacing:1rpx}
.product-arrow{color:#ee642d;font-size:27rpx;line-height:1}
.page-heading{padding:16rpx 0 24rpx}
.heading-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx}
.heading-code{font-size:18rpx;letter-spacing:3rpx;color:#8b929d}
.heading-mark{height:6rpx;width:38rpx;background:#ee642d}
.page-title{font-size:50rpx;font-weight:700;line-height:1.24;letter-spacing:-1rpx;margin:0 0 16rpx}
.page-subtitle{font-size:25rpx;color:#8a929e;line-height:1.7}
.list-divider{height:1rpx;background:#e9ecf0;margin:26rpx 0}
.list-footer{text-align:center;color:#969da7;font-size:22rpx;padding:36rpx}
.detail-hero-image{width:100%;height:590rpx;display:block;background:#eaedf0}
.detail-section{padding:34rpx 32rpx}
.detail-section-title{font-size:31rpx;font-weight:600;margin:0 0 23rpx;display:flex;align-items:center;line-height:1.5}
.detail-section-title::before{content:"";display:block;width:5rpx;height:28rpx;background:#ee642d;margin-right:17rpx}
.detail-line{white-space:pre-wrap;line-height:1.95;color:#6c7480;font-size:27rpx;word-break:break-word}
.bottom-action{position:fixed;left:0;right:0;bottom:0;z-index:20;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #e7e9ee}
.input,.textarea{width:100%;box-sizing:border-box;background:#f5f6f8;border:1rpx solid #e9ecf1;border-radius:9rpx;padding:0 24rpx;font-size:27rpx;color:#242a33}
.input{height:94rpx}
.textarea{height:250rpx;padding:24rpx;line-height:1.7}
.placeholder{color:#a3a9b2;font-size:25rpx}
.field-label{display:flex;justify-content:space-between;font-size:26rpx;font-weight:500;margin:30rpx 0 17rpx;color:#464e5b}
.required{color:#ee642d;margin-left:6rpx}
.brand-footer{padding:56rpx 0 16rpx;text-align:center}
.brand-footer-title{font-size:42rpx;font-weight:700;color:#c3c8d0;letter-spacing:12rpx}
.brand-footer-caption{font-size:17rpx;color:#9da4ae;letter-spacing:3rpx;margin-top:10rpx}
