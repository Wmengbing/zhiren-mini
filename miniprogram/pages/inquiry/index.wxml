<view class="container inquiry-page">
  <view class="page-heading"><view class="heading-top"><text class="heading-code">START A CONVERSATION</text><view class="heading-mark" /></view><view class="page-title">聊聊您的需求</view><view class="page-subtitle">从一个想法、一张图纸，开启合作的可能</view></view>
  <view wx:if="{{productName}}" class="product-tip"><text class="product-tip-label">正在咨询产品</text><text>{{productName}}</text></view>
  <view class="inquiry-form card"><view class="form-section-title"><text>01</text> 联系信息</view><view class="field-label"><text>您的称呼 <text class="required">*</text></text></view><input class="input" placeholder="请输入您的称呼" placeholder-class="placeholder" maxlength="50" value="{{name}}" bindinput="nameInput" /><view class="field-label"><text>联系电话 <text class="required">*</text></text></view><input class="input" placeholder="请输入中国大陆手机号" placeholder-class="placeholder" type="number" maxlength="11" value="{{phone}}" bindinput="phoneInput" />
  <view class="form-section-title form-second"><text>02</text> 合作需求</view><view class="field-label"><text>需求描述 <text class="required">*</text></text><text class="message-count">{{message.length}} / 1000</text></view><textarea class="textarea" placeholder="您需要什么产品？可填写用途、材质、数量或图纸要求。" placeholder-class="placeholder" maxlength="1000" value="{{message}}" bindinput="messageInput" /></view>
  <checkbox-group bindchange="consentChange"><label class="consent"><checkbox value="yes" color="#ee642d" /><text>同意提交以上信息，仅用于本次业务联系</text></label></checkbox-group><view class="inquiry-footnote" bindtap="showPrivacy">阅读《联系信息使用说明》 ↗</view><button class="primary-button submit-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit"><text>提交合作咨询</text><text>↗</text></button>
  <view class="inquiry-footnote">每一次沟通，都是合作的开始。</view>
</view>
