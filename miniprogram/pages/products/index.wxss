.products-page{padding-top:35rpx}
.products-page .page-title{font-size:46rpx}
.search-row{display:flex;margin:15rpx 0 30rpx}
.search-field{flex:1;min-width:0;background:#fff;border:1rpx solid #e1e5eb;border-radius:9rpx;display:flex;align-items:center;padding:0 23rpx}
.search-glass{width:23rpx;height:23rpx;border:3rpx solid #989faa;border-radius:50%;position:relative;margin-right:20rpx;flex-shrink:0}
.search-glass::after{content:"";width:11rpx;height:3rpx;background:#989faa;position:absolute;right:-8rpx;bottom:-5rpx;transform:rotate(45deg)}
.search-input{flex:1;min-width:0;height:90rpx;font-size:26rpx}
.search-button{height:90rpx;line-height:90rpx;background:#ee642d;color:#fff;padding:0 32rpx;border-radius:9rpx;font-size:26rpx;margin-left:14rpx}
.category-scroll{white-space:nowrap;margin-bottom:24rpx}
.category-list{display:inline-flex;padding-bottom:8rpx}
.category-item{padding:18rpx 25rpx;background:#fff;color:#7b8491;border:1rpx solid #e5e8ee;border-radius:7rpx;font-size:24rpx;margin-right:13rpx;flex-shrink:0}
.category-item.selected{background:#ee642d;color:#fff;border-color:#ee642d}
.catalog-meta{display:flex;justify-content:space-between;align-items:center;font-size:25rpx;font-weight:600;padding:14rpx 0 28rpx}
.catalog-count{font-size:22rpx;font-weight:400;color:#929aa6;margin-left:8rpx}
.catalog-hint{font-size:14rpx;color:#a4abb5;letter-spacing:1rpx;font-weight:400}
