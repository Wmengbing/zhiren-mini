<view class="container products-page">
  <view class="page-heading"><view class="heading-top"><text class="heading-code">PRODUCT CATALOG / 01</text><view class="heading-mark" /></view><view class="page-title">精密产品，多元应用</view><view class="page-subtitle">从阀体到五金，探索金属制造的更多可能</view></view>
  <view class="search-row"><view class="search-field"><view class="search-glass" /><input class="search-input" placeholder="搜索名称、材质或用途" placeholder-class="placeholder" value="{{keyword}}" bindinput="onKeyword" confirm-type="search" bindconfirm="search" /></view><view class="search-button" bindtap="search">搜索</view></view>
  <scroll-view scroll-x class="category-scroll" show-scrollbar="{{false}}"><view class="category-list"><view class="category-item {{selected === 0 ? 'selected' : ''}}" data-id="0" bindtap="selectCategory">全部产品</view><view wx:for="{{categories}}" wx:key="id" class="category-item {{selected === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectCategory">{{item.name}}</view></view></scroll-view>
  <view class="catalog-meta"><text>产品展示 <text class="catalog-count">/ {{total}}</text></text><text class="catalog-hint">PRECISION IN EVERY DETAIL</text></view>
  <view wx:if="{{items.length}}" class="product-grid"><view wx:for="{{items}}" wx:key="id" class="product-card" data-id="{{item.id}}" bindtap="goDetail"><view class="product-visual"><text class="product-index">P / {{item.id}}</text><image lazy-load wx:if="{{item.cover_url}}" src="{{item.thumbnail_url || item.cover_url}}" mode="aspectFit" class="product-image" /><view wx:else class="image-fallback">ZHIREN</view></view><view class="product-info"><view class="product-name">{{item.title}}</view><view class="product-subtitle">{{item.subtitle || '精密铸造件'}}</view><view class="product-card-foot"><text>查看产品</text><text class="product-arrow">↗</text></view></view></view></view>
  <view wx:if="{{!loading && !error && !items.length}}" class="empty">暂无匹配产品，试试其他分类或关键词</view><view wx:if="{{loading}}" class="list-footer">正在加载产品…</view><view wx:elif="{{!hasMore && items.length}}" class="list-footer">— 已展示全部产品 —</view>
<view wx:if="{{error}}" class="empty" bindtap="loadMore">{{error}} · 点击重试</view>
</view>
