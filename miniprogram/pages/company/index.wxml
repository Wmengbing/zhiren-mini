<view class="company-page">
  <view class="company-hero"><image lazy-load src="{{settings.company_image_mobile_url || settings.company_image_url || '/assets/images/official-factory.jpg'}}" class="company-photo" mode="aspectFill" /><view class="company-mask" /><view class="company-hero-copy"><view class="company-eyebrow">ABOUT ZHIREN / SINCE 1993</view><view class="company-headline">专注金属。<view>精于制造。</view></view><view class="company-hero-line" /><view class="company-name">{{settings.company_name || '江西志人不锈钢制品有限公司'}}</view><view class="company-image-note">官网厂区图片</view></view></view>
  <view class="container company-body"><view class="company-intro"><view class="section-kicker">CRAFT · MATERIAL · PRECISION</view><view class="company-intro-title">从材料，到更多可能</view><view class="body-text">{{settings.company_summary}}</view></view><view class="company-business"><view><text class="company-business-code">{{settings.founded_year}}</text><text>创立年份</text></view><view><text class="company-business-code">{{settings.annual_capacity}}</text><text>年生产能力</text></view><view><text class="company-business-code">{{settings.countries_served}}</text><text>国家及地区</text></view></view>
  <view class="section-kicker">COMPANY &amp; CAPABILITIES</view><view class="company-reading-hint">点击栏目，了解公司与制造能力</view>
  <view wx:for="{{pages}}" wx:key="id" class="company-section card"><view class="company-section-header" data-id="{{item.id}}" bindtap="toggleSection"><view class="company-section-heading"><view class="company-section-code">ZHIREN / {{index + 1}}</view><view class="company-section-title">{{item.title}}</view></view><text class="company-section-toggle">{{expandedPageId === item.id ? '−' : '+'}}</text></view><view wx:if="{{expandedPageId === item.id}}" class="company-section-body"><image lazy-load wx:if="{{item.image_url}}" src="{{item.image_url}}" mode="widthFix" class="section-image" data-url="{{item.image_url}}" bindtap="previewPhoto" /><view class="card-padding"><view class="detail-line">{{item.content}}</view></view></view></view><view wx:if="{{!pages.length}}" class="empty">公司资料即将完善</view>
  <view wx:if="{{videos.length}}" class="company-section card"><view class="company-section-header" bindtap="toggleVideos"><view class="company-section-heading"><view class="company-section-code">PRODUCTION IN MOTION</view><view class="company-section-title">生产现场 · {{videos.length}} 段视频</view></view><text class="company-section-toggle">{{videosOpen ? '−' : '+'}}</text></view><view wx:if="{{videosOpen}}" class="company-section-body video-body"><video class="production-video" src="{{videos[activeVideo].url}}" poster="{{videos[activeVideo].poster}}" controls show-center-play-btn enable-progress-gesture object-fit="contain" /><view class="video-current">{{videos[activeVideo].title}}</view><view class="video-switch"><view wx:for="{{videos}}" wx:key="url" class="video-choice {{index === activeVideo ? 'video-choice-active' : ''}}" data-index="{{index}}" bindtap="selectVideo"><text>{{index + 1}}</text>{{item.title}}</view></view></view></view>
  <view class="brand-footer"><view class="brand-footer-title">ZHIREN</view><view class="brand-footer-caption">专注金属，连接更多可能</view></view></view>
</view>
