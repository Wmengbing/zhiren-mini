<view wx:if="{{item}}" class="detail-page">
  <view class="detail-visual"><view class="detail-visual-meta"><text>ZHIREN / PRODUCT {{item.id}}</text><text>PRECISION CASTING</text></view><swiper wx:if="{{item.gallery.length > 1}}" class="product-gallery" indicator-dots indicator-color="#c8ced8" indicator-active-color="#ee642d" bindchange="galleryChange"><swiper-item wx:for="{{item.gallery}}" wx:key="*this"><image src="{{item}}" mode="aspectFit" class="detail-hero-image" bindtap="previewImages" /></swiper-item></swiper><image wx:elif="{{item.cover_url}}" src="{{item.cover_url}}" mode="aspectFit" class="detail-hero-image" bindtap="previewImages" /><view wx:else class="detail-fallback">ZHIREN METAL</view><view wx:if="{{item.gallery.length}}" class="gallery-note">{{galleryIndex + 1}} / {{item.gallery.length}} · 点击查看大图</view></view>
  <view class="detail-intro"><view class="category-tag">{{item.category}}</view><view class="detail-title">{{item.title}}</view><view class="detail-subtitle">{{item.subtitle}}</view><view wx:if="{{item.name_note}}" class="product-name-note">{{item.name_note}}</view><view class="detail-intro-footer"><text>从细节，认识产品</text><text class="detail-intro-arrow">↓</text></view></view>
  <view class="detail-content">
    <view wx:if="{{item.summary}}" class="detail-section detail-card"><view class="detail-section-code">01 / OVERVIEW</view><view class="detail-section-title">产品介绍</view><view class="detail-line">{{item.summary}}</view></view>
    <view wx:if="{{item.features}}" class="detail-section detail-card"><view class="detail-section-code">02 / FEATURES</view><view class="detail-section-title">产品特点</view><view class="detail-line">{{item.features}}</view></view>
    <view wx:if="{{item.specifications}}" class="detail-section detail-card specification-card"><view class="detail-section-code">03 / SPECIFICATIONS</view><view class="detail-section-title">规格参数</view><view class="specification-body">{{item.specifications}}</view></view>
    <view wx:if="{{item.application}}" class="detail-section detail-card"><view class="detail-section-code">04 / APPLICATION</view><view class="detail-section-title">应用领域</view><view class="detail-line">{{item.application}}</view></view>
  </view>
  <view class="detail-spacer" /><view class="bottom-action product-bottom"><view class="product-bottom-copy"><view>想了解更多？</view><text>沟通产品与合作需求</text></view><button class="primary-button" bindtap="inquire">咨询此产品 <text>↗</text></button></view>
</view>
