page{background:#fff}
.article-header{padding:48rpx 36rpx 36rpx}
.article-kicker{display:flex;align-items:center;color:#949da9;font-size:17rpx;letter-spacing:3rpx;margin-bottom:30rpx}
.article-dot{width:8rpx;height:8rpx;background:#ee642d;margin-right:14rpx}
.article-title{font-size:45rpx;line-height:1.5;font-weight:600;letter-spacing:-1rpx}
.article-date{font-size:20rpx;color:#a5acb7;margin-top:29rpx;display:flex;justify-content:space-between;flex-wrap:wrap;line-height:1.8}
.article-image{width:100%;display:block;background:#e9edf1}
.article-body{padding:38rpx 36rpx 70rpx}
.article-lead{font-size:28rpx;color:#4f5968;line-height:1.9;padding:25rpx 28rpx;background:#f3f5f7;border-left:4rpx solid #ee642d;margin-bottom:34rpx}
.article-content{font-size:29rpx;color:#626c7b;line-height:2;white-space:pre-wrap;word-break:break-word}
.article-source{font-size:22rpx;color:#8a95a5;line-height:1.8;display:flex;flex-wrap:wrap;justify-content:space-between;border-top:1rpx solid #e9edf3;padding-top:25rpx;margin-top:35rpx}
.article-source text:last-child{color:#c67551}
.article-end{display:flex;align-items:center;justify-content:center;margin-top:60rpx;font-size:17rpx;color:#b1b7c1;letter-spacing:3rpx}
.article-end>view{height:1rpx;width:60rpx;background:#e3e7ed;margin:0 25rpx}
