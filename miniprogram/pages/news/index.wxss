.news-card{display:flex;margin-top:22rpx}
.news-visual{width:202rpx;flex-shrink:0;position:relative;background:#e7eaef}
.news-image{width:100%;height:100%;min-height:240rpx;display:block}
.news-copy{padding:26rpx;flex:1;min-width:0}
.news-title{font-size:28rpx;font-weight:600;line-height:1.55;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}
.news-summary{font-size:23rpx;color:#929aa5;line-height:1.7;margin:13rpx 0 23rpx;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}
.news-meta{display:flex;justify-content:space-between;align-items:center;font-size:17rpx;color:#a0a7b1;flex-wrap:wrap}
.news-read{color:#c96b44;margin-top:5rpx}
.news-featured{display:block;margin-top:10rpx}
.news-featured .news-visual{width:100%}
.news-featured .news-image{height:345rpx}
.news-featured .news-copy{padding:32rpx}
.news-featured .news-title{font-size:34rpx}
.news-featured .news-summary{font-size:25rpx}
.news-featured .news-meta{font-size:20rpx;border-top:1rpx solid #edf0f3;padding-top:22rpx}
.news-latest{position:absolute;left:24rpx;top:24rpx;padding:10rpx 14rpx;background:#ee642d;color:#fff;font-size:16rpx;letter-spacing:2rpx;border-radius:3rpx}
