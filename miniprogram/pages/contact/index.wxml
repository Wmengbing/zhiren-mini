<view class="container contact-page">
  <view class="page-heading"><view class="heading-top"><text class="heading-code">LET'S CONNECT / 03</text><view class="heading-mark" /></view><view class="page-title">让合作，从沟通开始</view><view class="page-subtitle">欢迎咨询产品需求与金属加工合作</view></view>
  <view class="contact-banner"><view class="contact-banner-top"><text>ZHIREN CASTING</text><text class="contact-banner-symbol">↗</text></view><view class="contact-brand">{{contact.company_name || '江西志人不锈钢制品有限公司'}}</view><view class="contact-banner-line" /><view class="contact-banner-caption">铜合金 · 不锈钢 · 合金碳钢精密铸造</view></view>
  <view class="contact-card card">
    <view class="contact-row" wx:if="{{contact.phone}}" bindtap="call"><view class="contact-icon">TEL</view><view class="contact-copy"><view class="contact-label">联系电话 / PHONE</view><view class="contact-value">{{contact.phone}}</view></view><view class="contact-arrow">拨打 ↗</view></view>
    <view class="contact-row" wx:if="{{contact.contact_person}}"><view class="contact-icon">NAME</view><view class="contact-copy"><view class="contact-label">联系人 / CONTACT</view><view class="contact-value">{{contact.contact_person}}</view></view></view>
    <view class="contact-row" wx:if="{{contact.email}}" data-value="{{contact.email}}" bindtap="copyContact"><view class="contact-icon">MAIL</view><view class="contact-copy"><view class="contact-label">电子邮箱 / EMAIL</view><view class="contact-value">{{contact.email}}</view></view><view class="contact-copy-action">复制</view></view>
    <view class="contact-row" wx:if="{{contact.alternate_email}}" data-value="{{contact.alternate_email}}" bindtap="copyContact"><view class="contact-icon">MAIL</view><view class="contact-copy"><view class="contact-label">备用邮箱 / EMAIL</view><view class="contact-value">{{contact.alternate_email}}</view></view><view class="contact-copy-action">复制</view></view>
    <view class="contact-row" wx:if="{{contact.whatsapp}}" data-value="{{contact.whatsapp}}" bindtap="copyContact"><view class="contact-icon">WA</view><view class="contact-copy"><view class="contact-label">WHATSAPP</view><view class="contact-value">{{contact.whatsapp}}</view></view><view class="contact-copy-action">复制</view></view>
    <view class="contact-row" wx:if="{{contact.address}}" bindtap="map"><view class="contact-icon">ADD</view><view class="contact-copy"><view class="contact-label">生产联系地址 / ADDRESS</view><view class="contact-value">{{contact.address}}</view></view><view class="contact-copy-action">{{contact.latitude && contact.longitude ? '导航' : '复制'}}</view></view>
    <view class="contact-row" wx:if="{{contact.registered_address}}" data-value="{{contact.registered_address}}" bindtap="copyContact"><view class="contact-icon">REG</view><view class="contact-copy"><view class="contact-label">注册办公地址</view><view class="contact-value">{{contact.registered_address}}</view></view></view>
    <view class="contact-row" wx:if="{{contact.website}}" data-value="{{contact.website}}" bindtap="copyContact"><view class="contact-icon">WEB</view><view class="contact-copy"><view class="contact-label">公司官网 / WEBSITE</view><view class="contact-value">{{contact.website}}</view></view><view class="contact-copy-action">复制</view></view>
    <view class="contact-row" wx:if="{{contact.work_hours}}"><view class="contact-icon">TIME</view><view class="contact-copy"><view class="contact-label">工作时间 / HOURS</view><view class="contact-value">{{contact.work_hours}}</view></view></view>
    <view wx:if="{{!contact.phone && !contact.email && !contact.address}}" class="empty">联系方式正在完善，欢迎先提交合作需求。</view>
  </view>
  <image wx:if="{{contact.wechat_qr}}" src="{{contact.wechat_qr}}" mode="widthFix" class="qr-image" />
  <view class="contact-inquiry"><view class="contact-inquiry-title">有想法，聊一聊。</view><view class="contact-inquiry-subtitle">留下产品、图纸或合作需求</view><button class="primary-button inquiry-button" bindtap="inquire">提交合作咨询 <text>↗</text></button></view>
  <view class="brand-footer"><view class="brand-footer-title">ZHIREN</view><view class="brand-footer-caption">PRECISION STARTS WITH A CONVERSATION</view></view>
</view>
